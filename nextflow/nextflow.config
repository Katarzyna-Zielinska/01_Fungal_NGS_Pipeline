process {
    executor = 'local'
    maxForks = 2


    withName: FASTQC_RAW {
        cpus = 2
    }

    withName: CUTADAPT {
        cpus = 2
    }

    withName: FASTP {
        cpus = 2
    }

    withName: FASTQC_TRIMMED {
        cpus = 2
    }

    withName: HISAT2 {
        maxForks = 1
        cpus = 4
        memory = '8 GB'
    }


    withName: SAMTOOLS {
        maxForks = 1
        cpus = 2
        memory = '4 GB'
    }

    withName: BEDTOOLS_COVERAGE {
        maxForks = 1
        cpus = 1
        memory = '4 GB'
    }
}

docker.enabled = false
apptainer.enabled = false
cleanup = false
